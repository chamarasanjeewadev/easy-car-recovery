VITE_GOOGLE_MAPS_API_KEY=

# TowMyCar platform API — vehicle lookup + recovery request submission.
# Dev (API Gateway): https://l3uz0btv4l.execute-api.eu-west-2.amazonaws.com
# Prod: https://api.towmycar.uk
TOWMYCAR_API_BASE_URL=

# TowMyCar platform API for browser-side calls (free DVLA vehicle check).
VITE_TOWMYCAR_API_BASE_URL=

# Stripe publishable key from the Easy Car Recovery Stripe account (NOT the
# towmycar.uk account — payments are kept separate per brand).
VITE_STRIPE_PUBLISHABLE_KEY=

# Server-only Stripe secrets. Local dev: mirror these in .dev.vars.
# Production: `wrangler secret put STRIPE_SECRET_KEY` / `... STRIPE_WEBHOOK_SECRET`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
