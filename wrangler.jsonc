{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easy-car-recovery",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  // Keep the free workers.dev URL alive alongside the custom domain.
  "workers_dev": true,
  // Bind the production domain directly to this Worker. NOTE: this only takes
  // effect once the pre-existing proxied DNS records for these hostnames are
  // deleted in the Cloudflare dashboard (error code 100117 until then).
  "routes": [
    { "pattern": "easycarrecovery.uk", "custom_domain": true },
    { "pattern": "www.easycarrecovery.uk", "custom_domain": true }
  ],
  "vars": {
    "TOWMYCAR_API_BASE_URL": "https://api.towmycar.uk"
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
